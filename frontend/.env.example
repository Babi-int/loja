# So neste PC:
VITE_API_URL="http://localhost:3333/api"
# Outro computador na mesma rede — use IP do PC que roda o backend + porta 3333 (obrigatorio):
# VITE_API_URL="http://192.168.0.15:3333/api"
#
# Vercel — chamadas diretas ao backend: no painel (Environment Variables), VITE_API_URL=https://SUA-API.onrender.com/api
# Vercel — proxy /api (sem CORS no browser): nao defina VITE_API_URL; use VERCEL_BACKEND_URL=https://SUA-API.onrender.com (sem /api; disponivel no Edge Middleware)
